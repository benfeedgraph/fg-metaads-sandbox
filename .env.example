# Meta Ads & Commerce Sandbox Simulator
PORT=4790
# Graph API version path segment — must match FeedGraph META_GRAPH_VERSION (API_VERSION also accepted)
META_GRAPH_VERSION=v19.0

# Default sandbox ad account + catalog
# Ad account id (act_ prefix added automatically if omitted)
SANDBOX_AD_ACCOUNT_ID=act_1000000001
SANDBOX_AD_ACCOUNT_NAME=FeedGraph Sandbox Meta Store
SANDBOX_CATALOG_ID=2000000001
SANDBOX_CATALOG_NAME=FeedGraph Sandbox Catalog
SANDBOX_CURRENCY=INR

# Auth accepted by the sandbox (Bearer header or access_token query/body param)
SANDBOX_ACCESS_TOKEN=sandbox-access-token
SANDBOX_META_APP_ID=sandbox-app-id
SANDBOX_META_APP_SECRET=sandbox-app-secret

# Sandbox user identity (returned by /me)
SANDBOX_USER_ID=9000000001
SANDBOX_USER_NAME=FeedGraph Sandbox User
SANDBOX_USER_EMAIL=sandbox@feedgraph.local

# Data paths
DATA_DIR=./data
DB_PATH=./data/sandbox.db

# Seed configuration
PRODUCT_COUNT=2000
CAMPAIGN_COUNT=40
# Days of insight history to generate
INSIGHT_DAYS=90

# Set to false to disable the non-Meta /_dev routes (strict Graph-only surface)
SANDBOX_DEV_ROUTES=true
